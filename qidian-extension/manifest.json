{
  "manifest_version": 3,
  "name": "Qidian Chapter Scraper",
  "version": "2.1",
  "description": "Lưu chương Qidian về máy: chụp ảnh (.jpg) hoặc copy văn bản (.txt)",
  "permissions": ["activeTab", "downloads", "storage", "scripting", "nativeMessaging"],
  "host_permissions": [
    "https://www.qidian.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://aico.io.vn/*",
    "https://*.aico.io.vn/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Qidian Scraper"
  }
}
