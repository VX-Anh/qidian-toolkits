# ── Google Gemini (native SDK google-genai trên Vertex AI) ────────
# Auth (dev): Application Default Credentials
#   gcloud auth application-default login
#   gcloud config set project <PROJECT_ID>
# Auth (Docker/host): service-account JSON. Tải key từ GCP Console, đặt vào
#   ./secrets/gcp-sa.json (docker-compose mount sẵn read-only) và đặt
#   GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json (compose đã set hộ).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# Gemini 3 không tắt thinking được. LOW = nhanh/rẻ (hợp dịch). LOW|MEDIUM|HIGH|MINIMAL
THINKING_LEVEL=LOW
MAX_OUTPUT_TOKENS=16384

# Rate limit token-bucket nội bộ (hạ xuống nếu quota Vertex thấp)
LLM_RPM=500
LLM_TPM=150000

# ── Đường dẫn dữ liệu ─────────────────────────────────────────────────────
# Dev trên Windows: dùng đường dẫn C:\... như dưới.
# Khi deploy bằng Docker: KHÔNG cần set ở đây — docker-compose.yml đã override
# sang /data/... (volume bền vững). Các biến: INPUT_DIR, OUTPUT_DIR,
# OCR_IMAGES_DIR, VIETPHASE_DIR, DB_PATH.
INPUT_DIR=..\data\input
OUTPUT_DIR=..\data\output
RULES_DIR=rules

# Vị trí file SQLite (mặc định backend/db/state.db khi chạy dev).
# DB_PATH=backend/db/state.db

# Số TranslatorAgent chạy song song
CONCURRENCY=3

# ── OCR ───────────────────────────────────────────────────────────────────
# "paddle" = PaddleOCR offline (miễn phí), "gemini" = Gemini vision (tốn quota).
# OCR_DEFAULT_ENGINE=paddle
#
# Dev Windows: để OCR_SERVICE_URL trống → paddle chạy qua subprocess venv của
#   qidian-ocr (các biến PADDLE_PYTHON/PADDLE_OCR_SCRIPT/PADDLE_OCR_CWD).
# Docker/server: docker-compose.yml đã set OCR_SERVICE_URL=http://ocr:8000 →
#   paddle chạy qua sidecar service "ocr" (PaddleOCR GPU). Không cần set ở đây.
# OCR_SERVICE_URL=

# ── Bảo mật ───────────────────────────────────────────────────────────────
# Token bảo vệ /api/*. Bắt buộc khi deploy Docker. Tạo ngẫu nhiên, vd:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Trình duyệt: mở /login và nhập token. Extension: điền vào ô "API token".
# Để trống khi chạy local = tắt auth.
API_TOKEN=
# Origin khác được gọi API từ trình duyệt (phân tách dấu phẩy). Thường để trống.
# CORS_ORIGINS=
# true = FastAPI debug + auto-reload trình duyệt khi sửa code (chỉ dùng khi dev).
DEV_MODE=false
