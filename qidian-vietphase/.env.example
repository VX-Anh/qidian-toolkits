# ── Claude (Anthropic API) ─────────────────────────────────────────────
# API key: điền thẳng ANTHROPIC_API_KEY, hoặc để key trong file và trỏ
# ANTHROPIC_API_KEY_FILE tới file đó (Docker: ./secrets/anthropic_api_key, compose set hộ).
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=secrets/anthropic_api_key

# Model (KHÔNG dùng tiền tố CLAUDE_ — trùng biến môi trường của Claude Code).
MODEL_TRANSLATE=claude-sonnet-5-5   # dịch chương
MODEL_LIGHT=claude-haiku-5-5        # trích thuật ngữ, review, Story-Wiki
MODEL_VISION=claude-sonnet-5-5      # OCR ảnh bằng AI

# Mức suy nghĩ: low | medium | high | xhigh | max (dịch truyện: low là đủ, rẻ nhất)
LLM_EFFORT=low

# Dịch chương qua: api (mặc định, Claude API) | cli (Claude Code CLI `claude -p` headless,
# dùng gói đăng ký đã đăng nhập; Docker: docker exec -it -u app vietphase claude auth login).
# Trích thuật ngữ, review, Story-Wiki, OCR vẫn đi API.
# TRANSLATE_PROVIDER=api
# CLI_MODEL=            # rỗng = MODEL_TRANSLATE
# CLI_EFFORT=           # rỗng = mặc định của CLI
# CLI_TIMEOUT=900       # giây mỗi chương
# CLI_FALLBACK_API=true # CLI lỗi / hết hạn mức → dịch lại chương đó bằng API

# Dò tên riêng mới trước khi dịch (giữ tên nhất quán giữa các chương).
# NAME_SCOUT=true
# SCOUT_MODEL=          # rỗng = MODEL_TRANSLATE
MAX_OUTPUT_TOKENS=64000

# Rate limit token-bucket nội bộ (đặt theo hạn mức tier của tài khoản Anthropic)
LLM_RPM=500
LLM_TPM=150000

# ── Đường dẫn dữ liệu ─────────────────────────────────────────────────────
# Dev trên Windows: dùng đường dẫn C:\... như dưới.
# Khi deploy bằng Docker: KHÔNG cần set ở đây — docker-compose.yml đã override
# sang /data/... (volume bền vững). Các biến: INPUT_DIR, OUTPUT_DIR,
# OCR_IMAGES_DIR, VIETPHASE_DIR, DB_PATH.
INPUT_DIR=..\data\input
OUTPUT_DIR=..\data\output
RULES_DIR=rules

# Vị trí file SQLite (mặc định backend/db/state.db khi chạy dev).
# DB_PATH=backend/db/state.db

# Số TranslatorAgent chạy song song
CONCURRENCY=3

# ── OCR ───────────────────────────────────────────────────────────────────
# "paddle" = PaddleOCR offline (miễn phí), "claude" = Claude vision (tốn token).
# OCR_DEFAULT_ENGINE=paddle
#
# Dev Windows: để OCR_SERVICE_URL trống → paddle chạy qua subprocess venv của
#   qidian-ocr (các biến PADDLE_PYTHON/PADDLE_OCR_SCRIPT/PADDLE_OCR_CWD).
# Docker/server: docker-compose.yml đã set OCR_SERVICE_URL=http://ocr:8000 →
#   paddle chạy qua sidecar service "ocr" (PaddleOCR GPU). Không cần set ở đây.
# OCR_SERVICE_URL=

# ── Bảo mật ───────────────────────────────────────────────────────────────
# Token bảo vệ /api/*. Bắt buộc khi deploy Docker. Tạo ngẫu nhiên, vd:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Trình duyệt: mở /login và nhập token. Extension: điền vào ô "API token".
# Để trống khi chạy local = tắt auth.
API_TOKEN=
# Origin khác được gọi API từ trình duyệt (phân tách dấu phẩy). Thường để trống.
# CORS_ORIGINS=
# true = FastAPI debug + auto-reload trình duyệt khi sửa code (chỉ dùng khi dev).
DEV_MODE=false
